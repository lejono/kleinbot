# Optional chat-side roam outbox relay; see ../../docs/roam-outbox.md
# ROAM_OUTBOX_DIR=/Users/<bot-account>/team/kleinbot/outbox
# ROAM_BRIEFING_CHAT_JID=example-briefing-id
# ROAM_RESEARCH_CHAT_JID=example-research-id
# Up to 8 comma-separated name=chatId pairs; = / + are allowed in IDs
# ROAM_OUTBOX_EXTRA_CHANNELS=updates=example-group-id
# The folder chooses the audience; recipient fields in flags are ignored.
# Only the host environment chooses each folder's recipient.
