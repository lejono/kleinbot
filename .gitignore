node_modules/
dist/

# User data — NEVER commit. Lives only in the runtime dir ~/team/kleinbot/.
# Ship .example templates instead (e.g. prompts/*.example.md, chats.example.json).
data/                 # message history, state, notes, activity log, raw capture
prompts/              # ALL prompts, incl. per-group prompts (these are user data, not system code)
config/               # runtime config

# Credentials / identifiers (phone numbers, JIDs, group IDs, tokens)
.env
*.env
!.env.example

# Claude Code
.claude/

# Playwright
.playwright-mcp/

# Editor / OS
*.swp
*~
.~lock.*
*.backup

# Stray media (attachments are user data — keep them out of the repo)
*.mp3
*.m4a
*.aac
*.ogg
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.pdf
