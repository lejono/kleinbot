# Bot display name
BOT_NAME=Kleinbot
# How often to process accumulated messages (ms)
PROCESS_INTERVAL=60000
# Rolling message history size per chat (for context)
HISTORY_WINDOW=50
# Admin JID for /commands (optional, get from logs)
# ADMIN_JID=your_jid@lid
# Baileys log level
# LOG_LEVEL=warn
# Moltbook API key (get from: npx tsx scripts/moltbook-register.ts)
# MOLTBOOK_API_KEY=moltbook_xxx
# How often to browse Moltbook autonomously (ms, default: 4 hours)
# MOLTBOOK_HEARTBEAT_INTERVAL=14400000
# Signal transport
# SIGNAL_ACCOUNT=+447123456789
# SIGNAL_ADMIN_NUMBER=+447987654321
# SIGNAL_SOCKET_PATH=/run/user/1000/signal-cli/socket
# Editor-agent group ID (the /revise group). User data — set in your real .env, never in source.
# SIGNAL_EDITOR_GROUP_JID=base64groupid=
# Optional: a group whose messages from the admin count as admin messages for entourage flags.
# SIGNAL_ADMIN_GROUP_JID=
# Model executables and backends (claude or codex)
# CLAUDE_BIN=claude
# CODEX_BIN=codex
# Features disabled per Codex invocation; comma separated, empty disables nothing
# CODEX_DISABLE_FEATURES=browser_use,browser_use_external,browser_use_full_cdp_access,computer_use,in_app_browser
# MOLTBOOK_BACKEND=claude
# MOLTBOOK_MODEL=sonnet
# BRIEFING_BACKEND=claude
# BRIEFING_MODEL=opus
# Model timeouts in milliseconds
# MOLTBOOK_MODEL_TIMEOUT_MS=300000
# MOLTBOOK_COMMENT_TIMEOUT_MS=120000
# BRIEFING_MODEL_TIMEOUT_MS=300000
# Append full posts and bounded comment trees to the research corpus (off by default)
# RESEARCH_CAPTURE=1
# RESEARCH_MAX_COMMENT_FETCH=20
# Roam scheduling and recipient-free outbox; outbox is disabled when unset
# ROAM_TICK_INTERVAL=60000
# RESEARCH_HOUR_UK=3
# ROAM_OUTBOX_DIR=/var/lib/kleinbot-roam/outbox
# Shared-group mode is off by default: directories 0770, files 0640
# Group write permits rename/delete; provision traversal on the outbox root
# ROAM_OUTBOX_GROUP_READABLE=1
# ROAM_OUTBOX_MAX_MD_BYTES=262144
# Receiver protocol limits (may be lowered)
# ROAM_OUTBOX_MAX_TEXT_CHARS=4000
# ROAM_OUTBOX_MAX_FLAG_BYTES=16384
# Daily open-coding research; RESEARCH_MODEL has no default and must be set
# RESEARCH_BACKEND=codex
# RESEARCH_MODEL=your-model-name
# RESEARCH_BATCH_SIZE=20
# RESEARCH_MAX_BATCHES=10
# RESEARCH_MAX_POST_CHARS=2000
# RESEARCH_MODEL_TIMEOUT_MS=300000
# RESEARCH_SUMMARY_MAX_CODES=40
# RESEARCH_SUMMARY_MAX_QUOTES=30
# Daily wiki write-up: one call after classification; unset model skips with a log entry
# RESEARCH_WRITEUP_BACKEND=claude
# RESEARCH_WRITEUP_MODEL=your-model-name
# RESEARCH_WRITEUP_TIMEOUT_MS=300000
# Organising records first, newest first; existing mapped-page context has a ceiling of 5
# RESEARCH_WRITEUP_MAX_RECORDS=60
# RESEARCH_WRITEUP_MAX_EXISTING_PAGES=5
# Summary context byte cap (existing page reads use page-size allowances)
# RESEARCH_WRITEUP_CONTEXT_MAX_BYTES=262144
# Markdown/title byte limits (each); generated framing is additional
# New numeric wiki limits use defaults for invalid/non-positive values
# RESEARCH_PAGE_MAX_BYTES=20000
# Cap on successful distinct page writes, shared by daily and on-request writers
# RESEARCH_PAGES_MAX_PER_RUN=12
# Runtime root (set in the process environment before configuration is loaded)
# KLEINBOT_RUNTIME_DIR=/var/lib/kleinbot-roam
# Temporary root for model workspaces and schemas (default: OS temporary directory)
# KLEINBOT_TEMP_DIR=/tmp
# Quote cap may lower the 200-character schema ceiling; open codes stay short
# RESEARCH_MAX_QUOTE_CHARS=200
# Cap on the optional runtime prompt prompts/research-question.md
# RESEARCH_MAX_QUESTION_CHARS=2000
# RESEARCH_MAX_CODE_CHARS=64

# Two-folder pipe; shared directories or local copies from an external sync job
# Chat writes inbox, roam reads inbox; roam writes outbox, chat relays outbox
# Chat-to-roam inbox: both settings required on the chat side; only the dir on roam
# ROAM_INBOX_DIR=/var/lib/kleinbot-roam/inbox
# ROAM_PIPE_CHAT_JID=synthetic-group
# Off by default; set on the writer for 0770 directories and 0640 files
# ROAM_INBOX_GROUP_READABLE=1
# Phone-like numbers -> [number]; numeric or @name@server mentions -> [mention]
# Attachment labels are generated (file-1.pdf), with only short alphanumeric extensions
# MIME types must be lowercase type/subtype; invalid values -> application/octet-stream
# IDs use HMAC-SHA-256; data/roam-pipe-secret is private to the chat side (0600)
# Failed writes remain unprocessed and retry on later pipe writes, never through the model
# ROAM_INBOX_MAX_TEXT_CHARS=4000
# Outbox receiver: each channel requires its own pinned recipient
# ROAM_BRIEFING_CHAT_JID=synthetic-briefing
# ROAM_RESEARCH_CHAT_JID=synthetic-research
# Optional extra channels, up to 8 comma-separated name=chatId pairs
# Names: ^[a-z][a-z0-9-]{0,31}$; briefing, research and archive are reserved
# IDs: 1-200 characters, no whitespace, commas or controls; = / + are allowed
# ROAM_OUTBOX_EXTRA_CHANNELS=updates=example-group-id
# The folder chooses the audience; recipient fields in flags are ignored.
# Only the host environment chooses each folder's recipient.
# ROAM_OUTBOX_RELAY_INTERVAL=5000
# Roam inbox answerer; Claude-only confined corpus/wiki reads
# Non-Claude backends are refused: Codex cannot confine reads to research directories
# Runtime prompts/roam-chat.md overrides the built-in prompt
# Commands /pause, /resume, /focus <text>, /clearfocus, /status run in code, without a model
# Controls persist in data/research/control.json; pause affects participation only
# ROAM_INBOX_MAX_PER_TICK=5
# Retained handled ids; may lower the 500-id ceiling
# ROAM_INBOX_SEEN_LIMIT=500
# ROAM_CHAT_BACKEND=claude
# ROAM_CHAT_MODEL=sonnet
# ROAM_CHAT_TIMEOUT_MS=300000
# Recent conversation entries; reads only this many tail bytes from the private log
# ROAM_CHAT_CONTEXT_MESSAGES=20
# ROAM_CHAT_CONTEXT_MAX_BYTES=262144
# Non-command messages: isolated tool-less Claude intent first, confined research answer second
# Only intent can request controls or group notes; it reads operator-sourced group notes
# Intent excludes corpus, other wiki pages and runtime answer instructions
# ROAM_INTENT_MODEL=haiku
# ROAM_INTENT_TIMEOUT_MS=60000
# ROAM_INTENT_MIN_CONFIDENCE=0.7
# May lower the 2000-character guidance ceiling
# ROAM_CONTROL_MAX_DIRECTIVE_CHARS=2000
# Private wiki under KLEINBOT_RUNTIME_DIR/research-wiki; all wiki content remains data
# Append-only monthly UK activity log: code facts, operator excerpts, bot's own published excerpts
# ROAM_LOG_EXCERPT_CHARS=120
# Only the clean call appends group notes; commands and answer output cannot write them
# Append-only file; entry cap and bounded context tail starting at an entry boundary
# ROAM_GROUP_NOTE_MAX_CHARS=1000
# ROAM_GROUP_PAGE_CONTEXT_BYTES=16384

# Per-channel relay limits: oldest flags first, rolling-hour successful send cap
# Retry transport failures; wait up to the grace window for missing markdown
# Archives are read once at startup within the validator freshness window, never pruned
# ROAM_RELAY_MAX_PER_SWEEP=20
# ROAM_RELAY_MAX_PER_HOUR=30
# ROAM_RELAY_ATTACHMENT_GRACE_MS=600000
# ROAM_RELAY_SEEN_LIMIT=5000

# Maximum retained cross-pollination items (may be lowered)
# MOLTBOOK_CROSS_POLLINATION_QUEUE_LIMIT=50

# Inbox freshness: validator window (48 hours), maximum future skew 5 minutes
# Inbox timestamps are Unix seconds; outbox timestamps are milliseconds
# Answer and briefing jobs pre-check outbox writability; research run state is atomic
# Claude none/web calls disable MCP and runtime customizations, preserving explicit tools/prompts
# Outbox/platform text is refused if it contains a non-empty env secret value from:
# MOLTBOOK_API_KEY, CLAUDE_CODE_OAUTH_TOKEN, ANTHROPIC_API_KEY, OPENAI_API_KEY
